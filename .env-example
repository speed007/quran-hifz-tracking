# Quran Hifz Tracker - environment configuration
# Copy to `.env` and adjust the values for your installation.
# App settings use the HIFZ_ prefix (see backend/app/config.py).

# --- Database -------------------------------------------------------------
# Path to the SQLite database file. In docker compose this is overridden to
# point inside the persistent ./data volume; locally the default is
# sqlite:///./hifz.db.
HIFZ_DATABASE_URL=sqlite:///./hifz.db

# --- Security -------------------------------------------------------------
# Secret key used to sign auth sessions. Change this to a long random string.
HIFZ_SECRET_KEY=change-me-to-a-long-random-string

# --- Telegram -------------------------------------------------------------
# Bot token from @BotFather (https://t.me/BotFather). Leave empty to disable
# Telegram notifications.
HIFZ_TELEGRAM_BOT_TOKEN=
# Time (24h, Europe/London) the daily summary is sent, e.g. 18:00.
# HIFZ_TELEGRAM_DAILY_TIME=18:00

# --- MQTT (for the Alexa / Home Assistant announcement) -------------------
# Host and credentials for YOUR MQTT broker. Leave host empty to disable.
# Replace the placeholder values below with your own broker details
# (do not commit the real values).
HIFZ_MQTT_HOST=your-mqtt-broker-host
HIFZ_MQTT_PORT=1883
HIFZ_MQTT_USER=your-mqtt-username
HIFZ_MQTT_PASS=your-mqtt-password

# --- Alexa / revision announcement schedule ------------------------------
HIFZ_ALEXA_ENABLED=true
HIFZ_ALEXA_WEEKDAY_TIME=16:00
HIFZ_ALEXA_WEEKEND_TIME=11:00

# --- Default admin account (created on first run) ------------------------
# Change the password after first login; on a fresh database the seeded
# account uses these values.
HIFZ_DEFAULT_ADMIN_USERNAME=admin
HIFZ_DEFAULT_ADMIN_PASSWORD=admin

# --- Timezone (used by the scheduler) ------------------------------------
# HIFZ_TIMEZONE=Europe/London

# --- Cloudflare Tunnel -----------------------------------------------------
# Token for the Cloudflare Quick Tunnel / remote tunnel (no HIFZ_ prefix).
# Obtain this from the Cloudflare Zero Trust dashboard when you create a
# tunnel, then use `cloudflared tunnel login` if needed. Leave empty to skip
# the tunnel (the app then runs on port 5101 only).
CLOUDFLARED_TOKEN=
